# Public frontend build configuration. Never place server secrets in VITE_* values.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:3001
VITE_CLOUDFRONT_BASE_URL=

# Transportation map and admin coordinate picker. This browser key must be API- and HTTP-referrer-restricted.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
VITE_TRANSPORT_COUNTRY_CODE=CR

# Optional consent-gated browser analytics.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional public company and contact details.
VITE_COMPANY_NAME=RCN
VITE_CONTACT_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=
VITE_BUSINESS_HOURS=
VITE_COMPANY_LOCATION=

# Optional public social and review destinations. Use full HTTPS URLs.
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_TRIPADVISOR_URL=
VITE_GOOGLE_REVIEWS_URL=
VITE_YOUTUBE_URL=

# Preview and static-server configuration.
ALLOWED_HOSTS=
PORT=3000
STATIC_SERVER_GRACE_MS=10000
STATIC_SERVER_HARD_TIMEOUT_MS=15000
